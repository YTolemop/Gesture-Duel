{
  "name": "gesture-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/server/index.ts",
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "soak": "tsx tests/soak.ts"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "express": "4.21.2",
    "phaser": "3.90.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/express": "4.17.23",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "6.3.6",
    "vitest": "3.2.4"
  }
}
